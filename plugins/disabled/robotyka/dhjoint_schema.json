{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta","joints"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "convention": {"type":"string","enum":["classical","modified"]},
        "scheme": {"type":"string","enum":["joints-only","urdf-like"]},
        "angle_unit": {"type":"string","enum":["deg","rad"]},
        "length_unit": {"type":"string"},
        "version": {"type":"string"}
      }
    },
    "joints": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["name","type","a","alpha","d","theta"],
        "properties": {
          "name":{"type":"string"},
          "type":{"type":"string","enum":["revolute","prismatic","fixed"]},
          "parent_joint":{"type": ["string", "null"]},
          "a":{"type":"number", "minimum": 0},
          "alpha":{"type":"number", "minimum": -180, "maximum": 180},
          "d":{"type":"number"},
          "theta":{"type":"number", "minimum": -180, "maximum": 180},
          "limits": {
            "type":"array",
            "items":{"type":"number"},
            "minItems":2,
            "maxItems":2
          }
        }
      }
    }
  }
}
